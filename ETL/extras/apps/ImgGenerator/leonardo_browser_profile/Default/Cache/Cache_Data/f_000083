\n};\n\nconst makeModuleLogger = (module: string) => {\n  originalLogger.time(getModuleTimerLabel(module));\n  return (...args: unknown[]) => timedLog(module, ...args);\n};\n\nexport const coreLogger = makeModuleLogger(\"core\");\nexport const bulkLogger = makeModuleLogger(\"bulk\");\nexport const autoblockLogger = makeModuleLogger(\"autoblock\");\nexport const consentLogger = makeModuleLogger(\"consent\");\nexport const cookieLogger = makeModuleLogger(\"cookie\");\n","export const _DOCUMENT_ =\n  typeof document !== \"undefined\" ? document : ({} as Document);\nexport const _WINDOW_ = typeof window !== \"undefined\" ? window : ({} as Window);\nexport const _HEAD_ = (_DOCUMENT_ && _DOCUMENT_.head) || ({} as HTMLHeadElement);\n","const isString = (input: unknown): input is string => {\n  return typeof input === \"string\";\n};\n\nexport default isString;\n","const isArray = (input: unknown): input is unknown[] => Array.isArray(input);\n\nexport default isArray;\n","import { FALSE } from \"constants/primitives\";\nimport isArray from \"./isArray\";\nimport isString from \"./isString\";\n\nconst includes = <T>(haystack: string | T[], needle: T) => {\n  if (isArray(haystack)) {\n    return (haystack as T[]).includes(needle);\n  }\n\n  if (isString(haystack)) {\n    return (haystack as string).includes(needle as unknown as string);\n  }\n\n  return FALSE;\n};\n\nexport default includes;\n","import { FALSE, TRUE } from \"./primitives\";\n\nimport { CookieCategory } from \"types/consent\";\n\nexport const NECESSARY = \"necessary\";\nexport const PERFORMANCE = \"performance\";\nexport const FUNCTIONAL = \"functional\";\nexport const ADVERTISING = \"advertising\";\nexport const UNCLASSIFIED = \"unclassified\";\nexport const IAB_PURPOSES = \"iab_purposes\";\n\nexport const categories: CookieCategory[] = [\n  NECESSARY,\n  PERFORMANCE,\n  FUNCTIONAL,\n  ADVERTISING\n];\n\n// empty consent, for example when user clicks \"deny\" - which means he accept only necessay\nexport cons