urns {string} cookie expiration string\n */\nconst calculateCookieExpiration = (expiration: number): string => {\n  const date = new Date();\n  date.setTime(expiration * 1000);\n  return date.toUTCString();\n};\n\nconst saveLocalCookie = (\n  name: string,\n  value: string,\n  expiration: number | null = null,\n  bulkConfig: IBulkConfig | null,\n) => {\n  const cookieExpiration = expiration !== null\n    ? expiration\n    : getTimestamp() + YEAR_IN_SECONDS;\n\n  const cookie = {\n    [name]: encodeURIComponent(value),\n    expires: calculateCookieExpiration(cookieExpiration),\n    path: \"/\",\n    SameSite: \"Lax\",\n    secure: window.location.protocol === \"https:\",\n  };\n\n  if (bulkConfig && bulkConfig.id && bulkConfig.baseDomain) {\n    cookie.domain = bulkConfig.baseDomain;\n  }\n\n  const cookieString = objectKeys(cookie)\n    .map((key) => {\n      const value = cookie[key];\n      if (typeof value === \"boolean\") {\n        return value ? key : NULL;\n      }\n\n      return `${key}=${value}`;\n    }, [])\n    .filter(Boolean)\n    .join(\"; \");\n\n  _DOCUMENT_.cookie = cookieString;\n\n  return cookieString;\n};\n\nexport default saveLocalCookie;\n","import { NUMBER_0 } from \"constants/numbers\";\nimport saveLocalCookie from \"./saveLocalCookie\";\nimport { IBulkConfig } from \"types/config-files/mainConfig\";\n\nconst deleteLocalCookie = (cookieName: string, bulkConfig: IBulkConfig | null) => {\n  return saveLocalCookie(cookieName, \"\", NUMBER_0, bulkConfig);\n}\n\nexport default deleteLocalCookie;\n","import { CONSENT_COOKIE } from \"core/config\";\nimport deleteLocalStorageItem from \"helpers/deleteLocalStorageItem\";\nimport deleteLocalCookie from \"helpers/deleteLocalCookie\";\nimport { IBulkConfig } from \"types/config-files/mainConfig\";\nimport { NULL } from \"constants/primitives\";\n\nconst deleteLocalConsent = (bulkConfig: IBulkConfig | null = NULL) => {\n  deleteLocalCookie(CONSENT_COOKIE, bulkConfig);\n  deleteLocalStorageItem(CONSENT_COOKIE);\n};\n\nexport default deleteLocalConsent;\n","import { CONSENT_TYPE_CATEGORY, CONSENT_TYPE_GRANULAR, ConsentTimestamp, ConsentType, IConsent } from \"types/consent\";\n\nimport { CONSENT_COOKIE, WITHDRAW_COOKIE } from \"core/config\";\nimport { NULL } from \"constants/primitives\";\nimport { consentLogger } from \"helpers/logger\";\nimport { genericObject } from \"types/generic\";\nimport getCookie from \"helpers/getCookie\";\nimport getLocalStorageItem from \"helpers/getLocalStorageItem\";\nimport objectKeys from \"helpers/objectKeys\";\nimport report from \"helpers/report\";\nimport includes from \"helpers/includes\";\nimport deleteLocalStorageItem from \"helpers/deleteLocalStorageItem\";\n\nconst loadLocalConsentCookie = (): genericObject | null => {\n  const cookie = getCookie(CONSENT_COOKIE);\n  // cookie doesn't exist, no consent\n  if (!cookie) {\n    return NULL;\n  }\n\n  // Check if cookie is equal to \"withdraw\" value\n  if (cookie === WITHDRAW_COOKIE) {\n    return { value: cookie }\n  }\n\n  try {\n    const decoded: genericObject = JSON.parse(decodeURIComponent(cookie));\n\n    return decoded;\n  } catch (e) {\n    consentLogger(\"Failed to decode local consent cookie:\");\n    report(e);\n    // not valid JSON value in cookie\n    return NULL;\n  }\n};\n\nconst formatStoredValue = (\n  storedValue: genericObject\n): [IConsent, ConsentTimestamp, ConsentType] => {\n  const consent = objectKeys(storedValue).reduce(\n    (consentObj: genericObject, key: keyof typeof storedValue) => {\n      // don't pass a few keys to the final consent object\n      if (includes([\"version\", \"timestamp\", \"type\"], key)) {\n        return consentObj;\n      }\n\n      return { ...consentObj, [key]: !!storedValue[key] };\n    },\n    {}\n  );\n\n  let type: ConsentType = CONSENT_TYPE_CATEGORY;\n  if (includes(\n    [CONSENT_TYPE_CATEGORY, CONSENT_TYPE_GRANULAR],\n    storedValue.type || \"\"\n  )\n  ) {\n    type = storedValue.type;\n  }\n\n  return [\n    { ..