\n\n    // last key\n    if (i === pathParts.length - 1) {\n      return typeof nextObject === \"undefined\" ? fallback : nextObject;\n    }\n\n    if (!nextObject || !isObject(nextObject)) {\n      return fallback as F;\n    }\n\n    currentObject = nextObject;\n  }\n\n  return fallback as F;\n};\n\nexport default getByPath;\n","export const DEFAULT_NON_EU_BANNER_REGIONS = [\n  \"CA\", // California\n  \"QC\", // Quebec\n];\n","export const ACCESSIBILITY_BLOCK_LEAVING_DISMISS = \"dismiss\";\nexport const ACCESSIBILITY_BLOCK_LEAVING_DENIED = \"denied\";\nexport const ACCESSIBILITY_BLOCK_LEAVING_BLOCK = \"block\";\n\nexport type AccessibilityBlockLeavingType =\n  | typeof ACCESSIBILITY_BLOCK_LEAVING_DISMISS\n  | typeof ACCESSIBILITY_BLOCK_LEAVING_DENIED\n  | typeof ACCESSIBILITY_BLOCK_LEAVING_BLOCK;\n","import {\n  categories as AVAILABLE_CATEGORIES,\n  EMPTY_CATEGORY_CONSENT,\n} from \"constants/categories\";\nimport {\n  BANNER_WIDGET_LOCATION_BOTTOM,\n  BannerWidgetLocation,\n  BoxWidgetLocation,\n  CONTINUE_BTN_STYLE_DISABLED,\n  IConfigFileScript,\n  IWidgetConfigFile,\n  PANEL_COOKIES_TAB,\n  PANEL_POLICY_TAB,\n  PANEL_SETTINGS_TAB,\n  WIDGET_TYPE_BANNER,\n  WidgetLocations,\n} from \"types/config-files/mainConfig\";\nimport {\n  CONSENT_POLICY_CATEGORY_OPTIN,\n  CONSENT_POLICY_GRANULAR_OPTIN,\n  CONSENT_TYPE_CATEGORY,\n  CONSENT_TYPE_GRANULAR,\n  ConsentType,\n  CookieCategory,\n} from \"types/consent\";\nimport { FALSE, NULL, TRUE } from \"constants/primitives\";\n\nimport { DEFAULT_NON_EU_BANNER_COUNTRIES } from \"constants/countries\";\nimport { DottedPaths } from \"types/generic\";\nimport { SCRIPT_INTEGRATION_METHOD_BANNER_LOAD } from \"types/scriptIntegrationMethods\";\nimport { YEAR_IN_SECONDS } from \"constants/time\";\nimport getByPath from \"helpers/getByPath\";\nimport isArray from \"helpers/isArray\";\nimport isString from \"helpers/isString\";\nimport isObject from \"helpers/isObject\";\nimport includes from \"helpers/includes\";\nimport { DEFAULT_NON_EU_BANNER_REGIONS } from \"constants/regions\";\nimport { ACCESSIBILITY_BLOCK_LEAVING_DENIED } from \"types/accessibility\";\n\ntype DottedWidgetConfigKey = DottedPaths<IWidgetConfigFile>;\n\nexport interface WidgetConfig extends IWidgetConfigFile {\n  type: IWidgetConfigFile[\"widget\"][\"type\"];\n  location: IWidgetConfigFile[\"widget\"][\"location\"];\n  buttonsOrder: IWidgetConfigFile[\"widget\"][\"buttonsOrder\"];\n  fontFamily: IWidgetConfigFile[\"widget\"][\"fontFamily\"];\n  consentType: ConsentType;\n  isGranularPolicy: boolean;\n}\n\nexport const createWidgetConfig = (\n  config?: Partial<IWidgetConfigFile>\n): WidgetConfig => {\n  const _config = isObject(config) ? config : {};\n\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  const get = <T = any, F = null>(\n    path: DottedWidgetConfigKey,\n    fallback: F | null = NULL\n  ) => getByPath<T, F>(_config, path, fallback);\n\n  // eslint-disable-next-line @typescript-eslint/no-explicit-any\n  const getArray = <T extends any[] = any[], F extends any[] = T>(\n    path: DottedWidgetConfigKey,\n    fallback: F = [] as unknown as F\n  ): T | F => {\n    const list = get<T>(path) || fallback;\n    return isArray(list) ? (list as T | F) : fallback;\n  };\n\n  const getBool = (path: DottedWidgetConfigKey) =>\n    !!get<boolean, false>(path, FALSE);\n\n  const consentPolicy = get(\"consentPolicy\") || CONSENT_POLICY_CATEGORY_OPTIN;\n\n  const isGranularPolicy = consentPolicy === CONSENT_POLICY_GRANULAR_OPTIN;\n\n  const scripts = getArray<IConfigFileScript[], IConfigFileScript[]>(\n    \"scripts\"\n  ).map((script) => ({\n    ...script,\n    integration: script.integration || SCRIPT_INTEGRATION_METHOD_BANNER_LOAD,\n  }));\n\n  const widgetConfig: WidgetConfig = {\n    lastConsentReset: get(\"lastConsentReset\", NULL) || NULL,\n\n    additionalLink: get(\"additionalLink\", \"\") || \"\",\n\n    type: get(\"widget.type\", WIDGET_TYPE_BANNER) || WIDGET_TYPE_BANNER,\n\n    buttonsOrder: getArray(\"widget.buttonsOrder\"),\n\n    version: get(\"version\"),\n\n    get location(): IWidgetConfigFile[\"widget\"][\"location\"] {\n      const loc: BoxWidgetLocation | BannerWidgetLocation =\n        get(\"widget.location\");\n      const locations = WidgetLocations[this.type];\n      return includes(locations, loc) ? loc : locations[0];\n    },\n\n    get bulkConsent() {\n      const bulkConfig = get(\"bulkConsent\") || {};\n      return {\n        id: getByPath(bulkConfig, \"id\"),\n        group: getByPath(bulkConfig, \"group\", \"\"),\n        domains: getByPath<string[]>(bulkConfig, \"domains\", []) || [],\n        iframeUrl: getByPath(bulkConfig, \"iframeUrl\"),\n        baseDomain: getByPath(bulkConfig, \"baseDomain\"),\n      };\n    },\n\n    consentPolicy: consentPolicy,\n\n    isGranularPolicy: isGranularPolicy,\n\n    privacyPolicyUrl: get(\"privacyPolicyUrl\"),\n\n    showPrivacyUrlInBanner: getBool(\"showPrivacyUrlInBanner\"),\n\n    hideOutsideEU: getBool(\"hideOutsideEU\"),\n\n    showSuffixOnFirstLayer: getBool(\"showSuffixOnFirstLayer\"),\n\n    showNumberOfScriptsInBanner: getBool(\"showNumberOfScriptsInBanner\"),\n\n    loadCssWithLink: getBool(\"loadCssWithLink\"),\n\n    get tabsOnSettingsPanel(): IWidgetConfigFile[\"tabsOnSettingsPanel\"] {\n      const key = \"tabsOnSettingsPanel\";\n      const tabsConfig = getArray(key);\n      let tabs = [];\n\n      // handle sites without tabs config\n      if (!tabsConfig) {\n        tabs = [\n          PANEL_SETTINGS_TAB,\n          PANEL_COOKIES_TAB,\n          get(\"hideCookiePolicy\") ? \"\" : PANEL_POLICY_TAB,\n        ];\n      } else {\n        tabs = tabsConfig;\n      }\n\n      if (!includes(tabs, PANEL_SETTINGS_TAB)) {\n        tabs.unshift(PANEL_SETTINGS_TAB);\n      }\n      return tabs.filter((t) => !!t && isString(t));\n    },\n\n    languages: getArray(\"languages\"),\n\n    showLanguageSwitcher: getBool(\"showLanguageSwitcher\"),\n\n    banner_continue_button_type:\n      get(\"banne