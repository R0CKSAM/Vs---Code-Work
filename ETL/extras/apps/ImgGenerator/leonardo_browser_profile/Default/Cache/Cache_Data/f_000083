ame`;\nexport const MISSING_IAB_LIB_LEGINT_NAME = `${LOGS_PREFIX} TCF category with switch is missing IAB LIB legitimate interest name`;\n\nexport const WRONG_TCF_MULTI_CATEGORY_DATA = `${LOGS_PREFIX} Couldn't update categories. Wrong structure of passed data. To update multiple categories expected structure is this: [[categoryName, id], [categoryName, id]]`;\nexport const WRONG_TCF_SINGLE_CATEGORY_DATA = `${LOGS_PREFIX} Couldn't update category. Wrong structure of passed data. To update single category expected structure is this: [categoryName, id]`;\n\nexport const MISSING_AUTOBLOCK =\n  \"Missing window.CF_cookieAutoblock. Check your consent.js file\";\n","class ApiError<BodyType> extends Error {\n  body?: BodyType;\n\n  constructor(msg: string, body?: BodyType) {\n    super(msg);\n    this.body = body;\n  }\n}\n\nexport default ApiError;\n","const createPromise = <T = void>(\n  executor: (\n    resolve: (value: T | PromiseLike<T>) => void,\n    reject: (reason?: unknown) => void\n  ) => void\n): Promise<T> => {\n  return new Promise(executor);\n};\n\nexport default createPromise;\n","import { HttpHeaders } from \"types/generic\";\n\nimport { LOGS_PREFIX } from \"core/config\";\nimport ApiError from \"./ApiError\";\nimport createPromise from \"helpers/createPromise\";\n\nfunction fetchWrapper(\n  url: string,\n  config: RequestInit = {}\n): Promise<[Response, HttpHeaders]> {\n  return createPromise<[Response, HttpHeaders]>((resolve, reject) => {\n    const abort = (msg: string | number, body: object = {}) => {\n      reject(\n        new ApiError(`${LOGS_PREFIX} Request to ${url} failed: ${msg}`, body)\n      );\n    };\n\n    fetch(url, config).then(\n      (res) => {\n        if (!res.ok) {\n          if (res.status) {\n            if (res.status === 422) {\n              res\n                .json()\n                .then((body) => {\n                  abort(res.status, body);\n                })\n                .catch(() => abort(res.status));\n              return;\n            }\n\n            abort(res.status);\n            return;\n          }\n\n          abort(\"\");\n          return;\n        }\n\n        const headers: HttpHeaders = {};\n        res.headers.forEach((value, key) => {\n          headers[key.toLowerCase()] = value;\n        });\n\n        resolve([res, headers]);\n      },\n      (e) => {\n        abort(e.message);\n      }\n    );\n  });\n}\n\nexport default fetchWrapper;\n","import { HttpHeaders, genericObject } from \"types/generic\";\n\nimport fetchWrapper from \"./fetch\";\nimport createPromise from \"helpers/createPromise\";\n\nfunction getJson<ExpectedResponse extends genericObject>(\n  url: string,\n  config: RequestInit = {}\n): Promise<[ExpectedResponse, HttpHeaders]> {\n  return createPromise((resolve, reject) => {\n    fetchWrapper(url, {\n      ...config,\n      headers: { ...(config.headers || {}), Accept: \"application/json\" },\n    }).then(([res, headers]) => {\n      res\n        .json()\n        .then((body) => resolve([body as ExpectedResponse, headers]), reject);\n    }, reject);\n  });\n}\n\nexport default getJson;\n","export const WHITESPACE = [\n  // Basic whitespace characters.\n  \" \",\n  \"\\t\",\n  \"\\x0b\",\n  \"\\f\",\n  \"\\xa0\",\n  \"\\ufeff\",\n\n  // Line terminators.\n  \"\\n\",\n  \"\\r\",\n  \"\\u2028\",\n  \"\\u2029\",\n\n  // Unicode category \"Zs\" space separators.\n  // \"\\u1680\",\n  // \"\\u180e\",\n  // \"\\u2000\",\n  // \"\\u2001\",\n  // \"\\u2002\",\n  // \"\\u2003\",\n  // \"\\u2004\",\n  // \"\\u2005\",\n  // \"\\u2006\",\n  // \"\\u2007\",\n  // \"\\u2008\",\n  // \"\\u2009\",\n  // \"\\u200a\",\n  // \"\\u202f\",\n  // \"\\u205f\",\n  // \"\\u3000\",\n].join(\"\");\n\nconst trim = (string: string, char: string = \"\"): string => {\n  let trimmed = (string || \"\").toString().trim();\n  if (char) {\n    trimmed = trimmed.replace(new RegExp(`^${char}+`), '').replace(new RegExp(`${char}+$`), '');\n  }\n\n  return trimmed;\n}\n\nexport default trim;\n","import { ConfigFilesVersion } from \"types/config-files/mainConfig\";\nimport { NULL } from \"constants/primitives\";\nimport { STATIC_URL } from \"core/config\";\nimport trim from \"./trim\";\n\nconst getStaticFileUrl = (\n  filename: string,\n  version: ConfigFilesVersion = NULL\n) => {\n  const filePath = trim(filename, \"/\").replace(\"//\", \"/\"); // fix double // which may appear in some urls if path isn't concatenated correctly\n  return `${STATIC_URL}/${filePath}${version ? `?v=${version}` : \"\"}`;\n};\n\nexport default getStaticFileUrl;\n","const report = (...args: unknown[]): void => {\n  args.forEach(console.error);\n};\n\nexport default report;\n","const isObject = (input: unknown): input is object => {\n  return !!input && typeof input === \"object\";\n};\n\nexport default isObject;\n","const TEST_STRING = \"__storage_test__\";\n\nconst getLocalStorage: () => Storage | null = () => {\n  try {\n    const storage = window.localStorage;\n    if (!storage) {\n      return null;\n    }\n\n    storage.setItem(TEST_STRING, TEST_STRING);\n    storage.removeItem(TEST_STRING);\n    return storage;\n  } catch {\n    return null;\n  }\n};\n\nexport default getLocalStorage;\n","import { NULL } from \"constants/primitives\";\nimport getLocalStorage from \"./getLocalStorage\";\nimport report from \"./report\";\n\nfunction getLocalStorageItem<Value, Fallback>(\n  key: string,\n  fallback: Fallback\n): Value | Fallback {\n  const storage = getLocalStorage();\n  try {\n    if (!storage) {\n      return fallback;\n    }\n    const value = storage.getItem(key);\n    if (value === NULL) {\n      return fallback;\n    }\n\n    try {\n      return JSON.parse(value);\n    } catch (e) {\n      report(e);\n      return fallback;\n    }\n  } catch (e) {\n    report(e);\n    return fallback;\n  }\n}\n\nexport default getLocalStorageItem;\n","const objectKeys = <O extends Record<string, unknown>>(\n  o: O\n): Array<keyof O> => {\n  return Object.keys(o) as Array<keyof O>;\n};\n\nexport default objectKeys;\n","import { NULL } from \"constants/primitives\";\nimport { _DOCUMENT_ } from \"constants/dom\";\nimport report from \"./report\";\n\n// code from https://www.w3schools.com/js/js_cookies.asp\nconst getCookie = (cookieName: string): string | null => {\n  const name = cookieName + \"=\";\n  try {\n    const cookieArray = _DOCUMENT_.cookie.split(\";\");\n    for (let i = 0; i < cookieArray.length; i++) {\n      let c = cookieArray[i];\n      while (c.charAt(0) === \" \") {\n        c = c.substring(1);\n      }\n      if (c.indexOf(name) === 0) {\n        return decodeURIComponent(c.substring(name.length, c.length));\n      }\n    }\n  } catch (e) {\n    report(e);\n    return NULL;\n  }\n\n  return NULL;\n};\n\nexport default getCookie;\n","import getLocalStorage from \"./getLocalStorage\";\n\nconst saveLocalStorageItem = (key: string, value: unknown) => {\n  const storage = getLocalStorage();\n  if (!storage) {\n    return;\n  }\n\n  storage.setItem(key, JSON.stringify(value));\n};\n\nexport default saveLocalStorageItem;\n","import { ConsentPolicy, CookieCategory } from \"../consent\";\n\nimport { ActionButton } from \"constants/actionButtons\";\nimport { ScriptIntegrationMethod } from \"../scriptIntegrationMethods\";\nimport { AccessibilityBlockLeavingType } from \"types/accessibility\";\nimport {\n  ITCFSelectedGatpList,\n  ITCFSelectedVendorList,\n} from \"helpers/tcf/TCFConsentProvider/types\";\n\nexport interface IWidgetConfigFile {\n  baseConsent: IConfigFileBaseConsent;\n  preConsent: IConfigFileBaseConsent;\n  lastConsentReset: number | null;\n  bulkConsent: IBulkConfig;\n  consentPolicy: ConsentPolicy;\n  cookieCategories: CookieCategory[];\n  googleConsentModeEnabled: boolean;\n  microsoftConsentModeEnabled: boolean;\n  microsoftClarityEnabled: boolean;\n  disableGCMUpdateEvents: boolean;\n  banner_continue_button_type: ContinueButtonStyle;\n  hideOutsideEU: boolean;\n  hideCookiePolicy?: boolean;\n  tabsOnSettingsPanel: