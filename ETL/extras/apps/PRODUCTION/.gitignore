# Repository root is D:\; include the five user project folders only.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/old/
!/older/
!/Veto/
!/Veto Live/
!/Veto OTT/

# Veto holds crash diagnostics, not app source. Keep only its explanatory note.
/Veto/*
!/Veto/README.md

# Installed dependencies and binaries are restored separately, not versioned.
**/python_packages/
**/packages/
**/wheels/
**/node_modules/
**/tools/
**/.venv/
**/venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.lnk
**/.setup-complete

# Private runtime state, temporary workspaces and diagnostic/browser profiles.
**/.*/
**/backups/
**/setup_backups/
**/logs/
**/history/
**/deleted/
**/Crashpad/
**/*.log
**/*.pid
**/*.dmp
**/*.pma
**/*.tmp
**/.env
**/.env.*
**/*credentials*
**/*.pem
**/*.key

# Include current templates and uploaded assets, but not credential-bearing
# legacy project records or host configuration. Sanitized legacy copies live
# in project_exports/ and are generated by export_projects.py.
**/data/*
!**/data/templates/
!**/data/uploads/
!**/data/competitions/

# These two presets contain private credentials in their metadata. Keep local.
/Veto OTT/data/templates/fad7b57070e84141a005110124d52580.json
/Veto OTT/data/competitions/billie-jean-king-cup/templates/18926744d02b42d586b811c0a3f5a36a.json
