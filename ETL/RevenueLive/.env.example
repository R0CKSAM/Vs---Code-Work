# Copy to .env on the server; do not commit real credentials.
APP_ENV=production
APP_URL=https://example.com
ADMIN_URL=https://example.com/admin
USER_URL=https://example.com/user
PORTAL_MODE=single
ALLOWED_HOSTS=example.com

DB_DRIVER=mysql+pymysql
# For MariaDB/XAMPP use: DB_DRIVER=mariadb+pymysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=revenuelive
DB_USERNAME=revenuelive_app
DB_PASSWORD=replace-with-a-secret
# DB_SSL_CA=C:/certificates/mysql-ca.pem

DATA_DIR=D:/RevenueLiveData
UPLOAD_DIR=D:/RevenueLiveData/uploads
REVENUE_BACKUP_DIR=D:/RevenueLiveBackups
SESSION_COOKIE_NAME=revenuelive_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_TTL_SECONDS=28800
REVENUE_TRUSTED_PROXY=127.0.0.1

# Set these to enable invitation and password-reset email (SMTP STARTTLS).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=reports@example.com
# SMTP_USERNAME=reports@example.com
# SMTP_PASSWORD=replace-with-a-secret

# Later: split portals, same application and database, independent host-only sessions.
# PORTAL_MODE=split
# APP_URL=https://app.example.com
# ADMIN_URL=https://admin.example.com/admin
# USER_URL=https://app.example.com/user
# ALLOWED_HOSTS=app.example.com,admin.example.com
