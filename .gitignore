# Virtual environment
venv/
.env
# Temp folders
tmp/
.tmp/
duckdb_temp/
duckdb_temp_storage_*
*.tmp

# Python cache
__pycache__/
*.pyc
.pytest_cache/
**/.pytest_cache/

# Data files
*.parquet
*.gz
*.log

# ETL generated working data
ETL/data/raw/
ETL/data/stage/
ETL/data/lake/
ETL/data/.etl_*_state.json
ETL/output/cache/
ETL/output/state/
ETL/output/**/_duckdb_tmp/
ETL/output/pytest_tmp*/

# Optional: screenshots / design refs
SS/
superset/

# CSV / Excel
*.csv
!ETL/config/device_decode/*.csv
*.xlsx
*.xls

# Standalone extras and generated archives are not production ETL inputs.
# Existing tracked utility source remains tracked; new local assets stay out of Git.
ETL/extras/apps/Banner Maker/
ETL/extras/output_archives/
ETL/extras/one_off_data/
# Manual storage-cleanup quarantine can contain millions of generated files.
ETL/extras/DELETE_REVIEW_*/
ETL/extras/delete/
ETL/extras/test_tmp/
ETL/Twitter/seen_posts.json

# Generated dashboard HTML can exceed GitHub's file-size limit.
ETL/class/*.html
ETL/output/**/*.html
ETL/output/watch_hours/*.html
ETL/output/watch_hours/**/*.html
ETL/output/overview/*.html
ETL/output/exports/**/*.html
ETL/output/**/*.json
ETL/extras/repair_artifacts/
# Isolated micro-ETL benchmarks and their persistent local workspace are
# generated data; only the runner source belongs in Git.
ETL/output/benchmarks/
ETL/output/micro_live/

# ASRUN demo output is regenerated locally and can be too large for GitHub.
ETL/asrun_demo/output/*.html
ETL/asrun_demo/output/*.js
ETL/asrun_demo/output/data/
ETL/asrun_demo/data/raw/ASRUN-*.txt
ETL/asrun_demo/data/parsed/*_manifest.json
ETL/asrun_demo/.pytest_tmp*/
ETL/output/test_tmp/
ETL/extras/**/test_artifacts/
ETL/extras/**/python_caches/

# Large generated reverse-engineering dashboard exports are local-only.
reverseEngg/chrome_report_dashboard*.html
reverseEngg/channel_distribution_dashboard_shared.html

# Amagi browser automation keeps an authenticated local profile plus generated
# diagnostics, downloaded CSV reports, and run logs on this workstation.
ETL/edu/amagi_browser_profile/
ETL/edu/amagi_playwright_profile/
ETL/edu/diagnostics/
ETL/edu/downloads/
ETL/edu/logs/
ETL/edu/*.png

# P3 report output is generated from local Excel inputs; do not version generated reports.
r-j/P3-chrome report/output/

# Local backups and browser-validation artifacts
ETL/extras/backups/
ETL/extras/code_backups/
ETL/extras/validation/chrome_*/
ETL/extras/validation/master_dashboard/
ETL/extras/validation/*.png
ETL/output/browser_audit_*.png
ETL/output/validation/

# YT4 deployment bundles are reproducible from the tracked source files.
ETL/YT/*_remote_bundle.zip
ETL/YT/state/

# DuckDB cache/database files
*.duckdb
*.duckdb.wal
*.duckdb.tmp
*.db
*.db-wal
*.db-shm

# pDash generated cache
pDash_analytics_cache.duckdb
pDash_cache.duckdb
asn_lookup_cache.json
ETL/tools/node/node.exe
ETL/tools/rclone/rclone.exe
**/__pycache__/
# Additional virtualenv directories
venv310/
