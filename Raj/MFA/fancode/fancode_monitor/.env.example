# ─────────────────────────────────────────────────────────────────────────────
# FanCode Monitor – Environment Configuration
#
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# DO NOT commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Target website ────────────────────────────────────────────────────────────
BASE_URL=https://www.fancode.com

# ── Browser / Playwright ──────────────────────────────────────────────────────
# Set to false to watch the browser during E2E tests (headed mode).
BROWSER_HEADLESS=true

# Slow-motion delay in ms between Playwright actions (0 = disabled).
BROWSER_SLOW_MO=0

# Default navigation timeout in milliseconds.
BROWSER_TIMEOUT=30000

# Viewport dimensions.
BROWSER_VIEWPORT_WIDTH=1280
BROWSER_VIEWPORT_HEIGHT=720

# ── Paths ─────────────────────────────────────────────────────────────────────
SCREENSHOT_DIR=screenshots
LOG_DIR=logs
DATA_DIR=data

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Phase 9 – Alerting / Notification Engine ─────────────────────────────────
NOTIFICATION_ENABLED=true
EMAIL_BACKEND=console
SMTP_ENABLED=false
# SMTP transport settings:
# For Gmail on port 465 (implicit SSL): SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USE_SSL=true
# For standard SMTP on port 587 (STARTTLS): SMTP_PORT=587, SMTP_USE_TLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=recipient@example.com
ALERT_EMAIL_CC=
ALERT_EMAIL_BCC=
ALERT_RECIPIENTS=recipient@example.com
NOTIFICATION_MAX_EVENTS_PER_BATCH=50
NOTIFICATION_OUTPUT_DIR=data/notifications

# ── Phase 10 – Scheduler & Continuous Monitoring ──────────────────────────────
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=300
MONITOR_RUN_TIMEOUT_SECONDS=900
MONITOR_STAGE_TIMEOUT_SECONDS=300
MONITOR_MAX_RETRIES=1
MONITOR_RETRY_DELAY_SECONDS=2.0
MONITOR_LOCK_ENABLED=true
MONITOR_LOCK_FILE=data/monitor.lock
MONITOR_LOCK_TIMEOUT_SECONDS=1800
MONITOR_NOTIFICATION_ENABLED=true
SCRAPE_INTERVAL_MINUTES=60

# ── Phase 11 – Hardening, Observability & Data Maintenance ────────────────────
STALE_RUN_TIMEOUT_SECONDS=1800
SCRAPE_RUN_RETENTION_DAYS=30
CHANGE_EVENT_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=90
HEARTBEAT_FILE=data/monitor.heartbeat
HEARTBEAT_INTERVAL_SECONDS=15
LOG_STRUCTURED=false


# ── Phase 1 – Discovery Engine ────────────────────────────────────────────────
DISCOVERY_MAX_DEPTH=2
DISCOVERY_MAX_PAGES=30
DISCOVERY_MAX_LINKS_PER_PAGE=50
DISCOVERY_TIMEOUT_SECONDS=120
DISCOVERY_PAGE_TIMEOUT_MS=30000
DISCOVERY_WAIT_AFTER_LOAD_MS=2000
REQUEST_DELAY_SECONDS=1.5
DISCOVERY_OUTPUT_DIR=data/raw/discovery

# ── Phase 2 – Database & Persistence ──────────────────────────────────────────
DATABASE_URL=sqlite:///data/fancode.db
DATABASE_ECHO=false

# ── Phase 3 – Schedule Scraper ────────────────────────────────────────────────
SCHEDULE_URL=https://www.fancode.com/schedule
SCHEDULE_MAX_ITEMS=100
SCHEDULE_MAX_PAGES=5
SCHEDULE_TIMEOUT_SECONDS=60
SCHEDULE_WAIT_AFTER_LOAD_MS=3000
SCHEDULE_REQUEST_DELAY_SECONDS=1.0
SCHEDULE_SAVE_RAW=false
SCHEDULE_RAW_DIR=data/raw/schedule
SCHEDULE_DAYS_AHEAD=7
SCHEDULE_INCLUDE_PAST_DAYS=1
# ── Phase 4 – Sports & Tours Scraper ──────────────────────────────────────────
SPORTS_URL=https://www.fancode.com
SPORT_MAX_ITEMS=50
SPORT_TIMEOUT_SECONDS=45
SPORT_WAIT_AFTER_LOAD_MS=2000
SPORT_REQUEST_DELAY_SECONDS=1.0
SPORT_SAVE_RAW=false
SPORT_RAW_DIR=data/raw/sports

TOURS_URL=https://www.fancode.com
TOUR_MAX_ITEMS=50
TOUR_MAX_PAGES=3
TOUR_TIMEOUT_SECONDS=45
TOUR_WAIT_AFTER_LOAD_MS=2000
TOUR_REQUEST_DELAY_SECONDS=1.0
TOUR_SAVE_RAW=false
TOUR_RAW_DIR=data/raw/tours

# ── Phase 5 – Match Detail Scraper & Enrichment ───────────────────────────────
MATCH_DETAIL_TIMEOUT_SECONDS=45
MATCH_DETAIL_WAIT_AFTER_LOAD_MS=2000
MATCH_DETAIL_MAX_ITEMS=20
MATCH_DETAIL_REQUEST_DELAY_SECONDS=1.0
MATCH_DETAIL_SAVE_RAW=false
MATCH_DETAIL_RAW_DIR=data/raw/match_detail

# ── Phase 6 – Live Now Scraper ────────────────────────────────────────────────
LIVE_NOW_URL=https://www.fancode.com/live
LIVE_NOW_TIMEOUT_SECONDS=45
LIVE_NOW_WAIT_AFTER_LOAD_MS=2000
LIVE_NOW_MAX_ITEMS=50
LIVE_NOW_REQUEST_DELAY_SECONDS=1.0
LIVE_NOW_SAVE_RAW=false
LIVE_NOW_RAW_DIR=data/raw/live_now

# ── Phase 7 – Videos & Highlights Scraper ─────────────────────────────────────
VIDEO_SCRAPER_URL=https://www.fancode.com/video
VIDEO_SCRAPER_TIMEOUT_SECONDS=45
VIDEO_SCRAPER_WAIT_AFTER_LOAD_MS=2000
VIDEO_SCRAPER_MAX_ITEMS=50
VIDEO_SCRAPER_REQUEST_DELAY_SECONDS=1.0
VIDEO_SCRAPER_SAVE_RAW=false
VIDEO_SCRAPER_RAW_DIR=data/raw/videos



