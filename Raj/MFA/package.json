{
  "name": "mfa-totp-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev worker/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "d1:create": "wrangler d1 create mfa-demo-db",
    "d1:migrate:local": "wrangler d1 execute mfa-demo-db --local --file=./db/migrations/0000_init.sql",
    "d1:migrate:remote": "wrangler d1 execute mfa-demo-db --remote --file=./db/migrations/0000_init.sql",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "test": "tsx scripts/test-mfa-flow.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.1.21",
    "better-auth": "^1.1.21",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.39.0",
    "hono": "^4.6.14",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^3.101.0"
  }
}
