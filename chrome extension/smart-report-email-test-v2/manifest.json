{
  "manifest_version": 3,
  "name": "Smart Report - Outlook Screenshot Test",
  "version": "2.0.0",
  "description": "Manually capture and preview a Grafana dashboard, then test sending the PNG with Microsoft 365 Outlook.",
  "permissions": [
    "identity",
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://grafana-apj.trafficpeak.live/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "key": ""
}