{
  "manifest_version": 3,
  "name": "Smart Report - Company Edition",
  "version": "3.9.1",
  "minimum_chrome_version": "118",
  "description": "Branded Smart Report for scheduled Grafana screenshots via Microsoft Outlook or Gmail.",
  "permissions": [
    "identity",
    "storage",
    "alarms",
    "activeTab",
    "debugger",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://grafana-apj.trafficpeak.live/*",
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Report \u00b7 Dashboard to inbox",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "135438109521-b4ao4om1jdlv80g5i2a8shdfb169dusf.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.send",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  }
}
