{
  "manifest_version": 3,
  "name": "Smart Export — Grafana GEO",
  "short_name": "Smart Export",
  "version": "1.0.0",
  "description": "Export day-wise Grafana GEO playtime into one Excel or CSV master. Daily refresh without passwords or API keys.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["https://grafana-apj.trafficpeak.live/*"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Smart Export"},
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"}
}
