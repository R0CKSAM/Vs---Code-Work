{
  "manifest_version": 3,
  "name": "Smart Export \u2014 Smart Data Picker",
  "short_name": "Smart Export",
  "version": "2.1.0",
  "description": "Choose Grafana metrics using a searchable, safe catalog. Day-wise master exports with Excel and CSV, presets, and scheduled updates.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://grafana-apj.trafficpeak.live/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Smart Export",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
