{
  "manifest_version": 3,
  "name": "Smart Report - Company Edition",
  "version": "3.7.5",
  "minimum_chrome_version": "118",
  "description": "Reviewed, fixed-width Grafana screenshots with scroll capture, chart-paint checks and Outlook acceptance status.",
  "permissions": [
    "identity",
    "storage",
    "alarms",
    "activeTab",
    "debugger",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://grafana-apj.trafficpeak.live/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "key": "",
  "background": {
    "service_worker": "background.js"
  }
}
