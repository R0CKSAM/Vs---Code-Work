{
  "manifest_version": 3,
  "name": "Smart Report - Scheduled Outlook",
  "version": "3.0.0",
  "description": "Schedule private Grafana screenshot reporting by Outlook, with To/CC/BCC and downloadable logs.",
  "permissions": [
    "identity",
    "storage",
    "alarms",
    "tabs",
    "debugger",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*",
    "https://grafana-apj.trafficpeak.live/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "key": "",
  "background": {
    "service_worker": "background.js"
  }
}